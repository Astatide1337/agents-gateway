# Copy to .env for local Compose, or create the equivalent Coolify variables.
# Never commit a populated .env file.

# This file is the current bundled integration profile. The standalone target
# removes Temporal; see docs/v2/implementation-status.md for the remaining
# local-engine release gate.
AGW_ENVIRONMENT=development
AGW_AUTH_MODE=local
# Generate at least 32 random characters; do not use this placeholder.
AGW_AUTH_TOKEN=
AGW_AUTH_PRINCIPAL_ID=local-owner
AGW_LOCAL_ORGANIZATION_ID=00000000-0000-4000-8000-000000000001
AGW_LOCAL_PROJECT_ID=00000000-0000-4000-8000-000000000002
# Same values for local CLI commands.
AGW_ORGANIZATION_ID=00000000-0000-4000-8000-000000000001
AGW_PROJECT_ID=00000000-0000-4000-8000-000000000002
AGW_OIDC_ISSUER=
AGW_OIDC_AUDIENCE=
AGW_OIDC_TOKEN_HEADER=
AGW_BOOTSTRAP_ADMIN_SUBJECT=
AGW_SERVICE_TOKEN_PRIVATE_KEY=
AGW_SERVICE_TOKEN_ISSUER=agents-gateway
AGW_SERVICE_TOKEN_AUDIENCE=agents-gateway-api
AGW_SERVICE_TOKEN_KEY_ID=primary

# Required for the bundled profile.
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=
AGW_DB_NAME=agents_gateway
AGW_DB_USER=agw
AGW_DB_PASSWORD=
AGW_AUTH_DB_USER=agw_auth
AGW_AUTH_DB_PASSWORD=
# Used only by the optional, not-yet-integrated `artifacts` profile.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
AGW_S3_BUCKET=agw-artifacts

# Standalone runner transport. Select `mtls` and populate the endpoint/TLS
# variables only for an optional remote runner.
AGW_RUNNER_TRANSPORT=unix
AGW_RUNNER_SOCKET=/run/agw-runner/runner.sock
AGW_RUNNER_ENDPOINT=
AGW_RUNNER_TLS_SERVER_NAME=
AGW_RUNNER_TLS_CA_FILE=
AGW_RUNNER_TLS_CERT_FILE=
AGW_RUNNER_TLS_KEY_FILE=
AGW_RUNNER_REQUEST_TIMEOUT=30s

# Set these when using managed services. The bundled profile is then omitted.
AGW_DATABASE_URL=
AGW_AUTH_DATABASE_URL=
# Privileged, deployment-time-only connection used by the `migrate` profile.
# Do not expose this value to agw-server or agw-worker.
AGW_MIGRATION_DATABASE_URL=
AGW_TEMPORAL_ADDRESS=
AGW_TEMPORAL_TASK_QUEUE=agents-gateway-v2
# Set true only for bundled Temporal on the private Compose network.
# Managed/remote Temporal should remain false and use TLS below.
AGW_TEMPORAL_INSECURE=true
AGW_TEMPORAL_TLS_SERVER_NAME=
AGW_TEMPORAL_TLS_CA_FILE=
AGW_TEMPORAL_TLS_CERT_FILE=
AGW_TEMPORAL_TLS_KEY_FILE=
AGW_S3_ENDPOINT=
AGW_S3_REGION=us-east-1
AGW_S3_ACCESS_KEY_ID=
AGW_S3_SECRET_ACCESS_KEY=

# Legacy static development auth; local mode above is the production-safe
# owner-operated token mode.
AGW_AUTH_ROLE=
AGW_AUTH_ORGANIZATION_ID=
AGW_AUTH_PROJECT_ID=
AGW_ALLOW_INSECURE_DEV_AUTH=false

# Optional image overrides for Coolify/registry deployments.
AGW_SERVER_IMAGE=agents-gateway-v2-server:local
AGW_WORKER_IMAGE=agents-gateway-v2-worker:local
AGW_CONSOLE_IMAGE=agents-gateway-v2-console:local

# The default collector emits to its debug exporter. Replace the mounted
# collector config with a Grafana/OTLP config in the deployment environment.
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_EXPORTER_OTLP_INSECURE=true
AGW_OTEL_INSECURE_HOSTS=otel-collector
AGW_OTEL_CONFIG_FILE=./otel-collector.yaml
# For Grafana Cloud, use ./otel-collector.grafana.yaml and set both values.
AGW_OTEL_REMOTE_ENDPOINT=
AGW_OTEL_REMOTE_AUTH=
# Standalone installs may disable export without running a collector.
AGW_TELEMETRY_DISABLED=false
