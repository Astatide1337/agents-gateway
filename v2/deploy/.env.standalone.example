# Copy this file to .env.standalone and set every blank value before starting
# Compose. Keep the populated file mode 0600 and outside version control.
# The installer creates this file with random values when it does not exist.

AGW_ENVIRONMENT=production
AGW_AUTH_MODE=local
AGW_AUTH_TOKEN=
# CLI aliases. For a generated file these equal the values above/below.
AGW_TOKEN=
AGW_AUTH_PRINCIPAL_ID=local-owner
AGW_LOCAL_ORGANIZATION_ID=00000000-0000-4000-8000-000000000001
AGW_LOCAL_PROJECT_ID=00000000-0000-4000-8000-000000000002
AGW_ORGANIZATION_ID=00000000-0000-4000-8000-000000000001
AGW_PROJECT_ID=00000000-0000-4000-8000-000000000002

AGW_ORCHESTRATION_MODE=local
AGW_EXECUTION_MODE=standalone

POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=
AGW_DB_NAME=agents_gateway
AGW_DB_USER=agw
AGW_DB_PASSWORD=

AGW_POSTGRES_IMAGE=postgres:latest
AGW_SERVER_IMAGE=agents-gateway-v2-server:local
AGW_CONSOLE_IMAGE=agents-gateway-v2-console:local
AGW_CONSOLE_PORT=8080
AGW_SERVER_URL=http://127.0.0.1:8080

# Filled by the installer for the host runner socket permissions.
AGW_RUNNER_UID=65532
AGW_SERVER_UID=65532
AGW_RUNNER_GID=65532
AGW_RUNNER_SOCKET_DIR=/run/agw-runner
AGW_RUNNER_SOCKET=/run/agw-runner/runner.sock
AGW_BROKER_ROOT=/run/agw-broker
AGW_ARTIFACT_HOST_ROOT=/var/lib/agents-gateway/artifacts
# Optional host-side broker integrations. Sandboxes never receive these.
AGW_SKILLS_GATEWAY_URL=
SKILLS_GATEWAY_AUTH_TOKEN=
OPENAI_API_KEY=
# Optional override; normally leave blank to use OpenAI's Responses API.
AGW_OPENAI_RESPONSES_URL=
OPENROUTER_API_KEY=
# Optional override; normally leave blank to use OpenRouter's Responses API.
AGW_OPENROUTER_RESPONSES_URL=

# Keep optional distributed-service variables out of this profile.
