# syntax=docker/dockerfile:1

FROM node:latest AS builder

WORKDIR /src
COPY v2/web/package.json v2/web/package-lock.json ./
RUN npm ci --ignore-scripts
COPY v2/web/ ./
RUN npm run build

FROM nginxinc/nginx-unprivileged:latest
# Coolify injects SERVICE_NAME_AGW_SERVER and suffixes it for PR previews.
# Restrict envsubst to this variable so Nginx's own $host/$scheme variables
# remain intact in the generated configuration.
ENV NGINX_ENVSUBST_FILTER=SERVICE_NAME_AGW_SERVER
COPY v2/deploy/nginx.conf /etc/nginx/templates/default.conf.template
COPY --from=builder /src/dist /usr/share/nginx/html
EXPOSE 8080
