FROM docker.io/library/golang:1.26.5@sha256:7caba5286b4c3613a337b709c573047d8ae62ee76106647313b61e72b99f20af AS build
WORKDIR /src/v3
COPY v3/go.mod v3/go.sum ./
RUN go mod download
COPY v3/ ./
RUN CGO_ENABLED=0 go build -trimpath -ldflags='-s -w' -o /out/agw-skills ./cmd/agw-skills
RUN install -d -m 0700 -o 1000 -g 1000 /out/run/agw/skills \
    && install -m 0400 -o 1000 -g 1000 /dev/null /out/run/agw/skills/token \
    && test -f /out/run/agw/skills/token \
    && test ! -L /out/run/agw/skills/token

FROM gcr.io/distroless/static-debian12:nonroot@sha256:1b7b9f0f0e0a1d2155f531db587cc48ec26aaf97ab64364225f5bf18a054e66a
COPY --from=build /out/agw-skills /agw/skills
COPY --from=build --chown=1000:1000 /out/run/ /run/
ENTRYPOINT ["/agw/skills"]
