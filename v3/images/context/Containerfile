# syntax=docker/dockerfile:1

ARG GO_IMAGE=docker.io/library/golang:1.26.5@sha256:7caba5286b4c3613a337b709c573047d8ae62ee76106647313b61e72b99f20af

FROM ${GO_IMAGE} AS build
ARG TARGETOS=linux
ARG TARGETARCH=amd64
WORKDIR /src/v3
COPY v3/go.mod v3/go.sum ./
RUN go mod download
COPY v3/api ./api
COPY v3/cmd ./cmd
COPY v3/internal ./internal
COPY v3/pkg ./pkg
RUN CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} \
    go build -trimpath -buildvcs=false -ldflags='-s -w' \
    -o /out/agw-context ./cmd/agw-context

FROM docker.io/library/debian:bookworm-slim@sha256:abd67ffcfa541b485a3dff59865ab629aa048a6c613e639d36e7456b0b229241

RUN apt-get update \
    && apt-get install --no-install-recommends --yes ca-certificates git \
    && rm -rf /var/lib/apt/lists/*

COPY --from=build /out/agw-context /agw/context

# The workload selects namespaced UID 0 so the init container can seal the
# dedicated output volume root-owned. hostUsers:false keeps this from being
# host root; no privilege or capability is requested.
USER 0:0
WORKDIR /opt/agw/context
ENTRYPOINT ["/agw/context"]
