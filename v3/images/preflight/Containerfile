# syntax=docker/dockerfile:1

# Build from the repository root: `docker build -f v3/images/preflight/Containerfile .`.
# The dependency image is pinned to the reviewed amd64 base manifest. The
# resulting application image must still be resolved to its own registry
# manifest digest before Helm use.
ARG GO_IMAGE=docker.io/library/golang:1.26.5@sha256:7caba5286b4c3613a337b709c573047d8ae62ee76106647313b61e72b99f20af

FROM ${GO_IMAGE} AS build
WORKDIR /src
COPY v3/go.mod v3/go.sum ./
RUN go mod download
COPY v3/ ./
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 \
    go build -trimpath -buildvcs=false -ldflags='-s -w' \
    -o /out/agw-preflight ./cmd/agw-preflight

FROM docker.io/library/alpine:3.22.1@sha256:4bcff63911fcb4448bd4fdacec207030997caf25e9bea4045fa6c8c44de311d1
ARG VCS_REF=unknown
ARG BUILD_DATE=unknown

LABEL org.opencontainers.image.title="Agents Gateway preflight attestor" \
      org.opencontainers.image.description="Fail-closed Kubernetes security preflight for Agents Gateway v3" \
      org.opencontainers.image.source="https://github.com/Astatide1337/agents-gateway" \
      org.opencontainers.image.revision="${VCS_REF}" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.licenses="MIT" \
      com.astatide.agw.component="preflight" \
      com.astatide.agw.api="agents.astatide.com/v1alpha1"

RUN apk add --no-cache ca-certificates tzdata \
    && addgroup -S -g 1337 agw-preflight \
    && adduser -S -D -H -u 1337 -G agw-preflight -s /sbin/nologin agw-preflight \
    && addgroup -S -g 1000 agw-agent \
    && adduser -S -D -H -u 1000 -G agw-agent -s /sbin/nologin agw-agent \
    && install -d -m 0755 /agw /evidence /hostproc /host/kubelet /host/runtime \
    && install -d -m 0755 /var/run/agw/preflight

COPY --from=build /out/agw-preflight /agw/preflight
RUN chmod 0755 /agw/preflight

# The Helm workload overrides this user to 1000 for the credential-free probe
# container. The writer's explicit securityContext remains UID/GID 1337.
USER 1337:1337
WORKDIR /agw
ENTRYPOINT ["/agw/preflight"]
