# syntax=docker/dockerfile:1

# Build inputs are pinned to the reviewed amd64 base manifests. The resulting
# application image must still be pushed and resolved to its own registry
# manifest digest before it is placed in Agent.spec.runtime.image.
ARG GO_IMAGE=docker.io/library/golang:1.26.5@sha256:7caba5286b4c3613a337b709c573047d8ae62ee76106647313b61e72b99f20af

FROM ${GO_IMAGE} AS build
WORKDIR /src
COPY v3/go.mod v3/go.sum ./
RUN go mod download
COPY v3/ ./
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 \
    go build -trimpath -ldflags='-s -w' -o /out/agw-broker ./cmd/agw-broker

FROM docker.io/library/alpine:3.22.1@sha256:4bcff63911fcb4448bd4fdacec207030997caf25e9bea4045fa6c8c44de311d1
ARG VCS_REF=unknown
ARG BUILD_DATE=unknown

LABEL org.opencontainers.image.title="Agents Gateway broker" \
      org.opencontainers.image.description="Loopback-only per-run policy broker for Agents Gateway v3" \
      org.opencontainers.image.source="https://github.com/Astatide1337/agents-gateway" \
      org.opencontainers.image.revision="${VCS_REF}" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.licenses="MIT" \
      com.astatide.agw.component="broker" \
      com.astatide.agw.runtime.protocol="agw.runtime.v1" \
      com.astatide.agw.completion="operator-observed-exit" \
      com.astatide.agw.go.module="github.com/Astatide1337/agents-gateway/v3"

RUN apk add --no-cache ca-certificates \
    && install -d -m 0755 /agw \
    && install -d -m 0700 -o 1337 -g 1337 /run/agw/credentials /run/agw/object-store /run/agw/broker \
    && install -m 0400 -o 1337 -g 1337 /dev/null /run/agw/object-store/access-key-id \
    && install -m 0400 -o 1337 -g 1337 /dev/null /run/agw/object-store/secret-access-key \
    && install -m 0400 -o 1337 -g 1337 /dev/null /run/agw/object-store/session-token

COPY --from=build /out/agw-broker /agw/broker
RUN chmod 0755 /agw/broker

ENV AGW_LISTEN_ADDRESS=127.0.0.1:8081

# The Kubernetes work Sandbox fixes the broker to this non-root UID. No
# provider, object-store, or process-exit credential is embedded in the image.
USER 1337:1337
WORKDIR /agw
ENTRYPOINT ["/agw/broker"]
